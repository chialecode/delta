#!/bin/sh
# Local pre-push gate. Enable once per clone: git config --local core.hooksPath .githooks
# Runs the quick gate with --all: at push time the changes are already committed, so the
# "changed since HEAD" selection would skip clippy and tests; --all covers the whole workspace.
# Skip once with `git push --no-verify` and say why in the PR; a hook never replaces
# the remote `main-protection` ruleset and its required `repository-quality` check.
set -eu
root=$(git rev-parse --show-toplevel)
# Pick an interpreter that really runs (the Windows Store "python" alias exists but fails).
py=
for candidate in python python3 py; do
  if "$candidate" -c "import sys" >/dev/null 2>&1; then py=$candidate; break; fi
done
if [ -z "$py" ]; then echo "pre-push: Python 3 not found; install it or push with --no-verify and say why in the PR" >&2; exit 1; fi
"$py" -B "$root/scripts/quick_gate.py" --all
