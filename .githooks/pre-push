#!/bin/sh
# Local pre-push gate. Enable once per clone: git config --local core.hooksPath .githooks
# Runs the everyday quick gate (docs, whitespace, fmt, clippy and tests of changed crates).
# Skip once with `git push --no-verify` and say why in the PR; a hook never replaces
# the remote `main-protection` ruleset and its required `repository-quality` check.
set -eu
root=$(git rev-parse --show-toplevel)
py=python
command -v "$py" >/dev/null 2>&1 || py=python3
"$py" -B "$root/scripts/quick_gate.py"
